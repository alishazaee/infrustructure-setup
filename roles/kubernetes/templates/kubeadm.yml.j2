apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ ansible_host }}"
  bindPort: {{ k8s_apiserver_port }}
nodeRegistration:
  name: "{{ inventory_hostname }}"
  criSocket: "{{ k8s_cri_socket }}"
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: "{{ project_prefix }}-{{ deployment_environment }}"
kubernetesVersion: "v{{ k8s_version }}"
controlPlaneEndpoint: "{{ k8s_control_plane_endpoint }}"
imageRepository: "{{ k8s_nexus_kubernetes_registry }}"
apiServer:
  certSANs:
{% for control_plane in k8s_control_plane_hosts | sort %}
    - "{{ hostvars[control_plane].ansible_host }}"
    - "{{ control_plane }}"
{% endfor %}
dns:
  # CoreDNS is nested below registry.k8s.io/coredns upstream. kubeadm appends
  # the image name, so retain that namespace when using the Nexus connector.
  imageRepository: "{{ k8s_nexus_kubernetes_registry }}/coredns"
networking:
  podSubnet: "{{ k8s_pod_cidr }}"
  serviceSubnet: "{{ k8s_service_cidr }}"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
resolvConf: /run/systemd/resolve/resolv.conf
