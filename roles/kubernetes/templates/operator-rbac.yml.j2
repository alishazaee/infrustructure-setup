apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: "{{ k8s_user }}-cluster-admin"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: "{{ k8s_user_cluster_role }}"
subjects:
  - apiGroup: rbac.authorization.k8s.io
    kind: Group
    name: "{{ k8s_user_group }}"
