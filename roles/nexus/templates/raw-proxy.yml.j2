# Ansible renders this configuration and submits it to the Nexus REST API.
name: "{{ nexus_repository.name }}"
online: true
storage:
  blobStoreName: "{{ nexus_repository.blob_store }}"
  strictContentTypeValidation: {{ nexus_repository.strict_content_type_validation | bool | lower }}
proxy:
  remoteUrl: "{{ nexus_repository.remote_url }}"
  contentMaxAge: 1440
  metadataMaxAge: 1440
negativeCache:
  enabled: true
  timeToLive: 1440
httpClient:
  blocked: false
  autoBlock: true
