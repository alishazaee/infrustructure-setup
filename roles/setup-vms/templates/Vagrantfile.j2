# Generated by Ansible. Edit inventories and templates, then rerun the playbook.
Vagrant.configure("2") do |config|
  config.vm.box = {{ vm_box | to_json }}
  config.vm.box_version = {{ vm_box_version | to_json }}
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 120

  config.vm.provider :libvirt do |provider|
    provider.uri = {{ libvirt_uri | to_json }}
    provider.driver = "kvm"
    provider.management_network_name = {{ (project_prefix ~ '-' ~ deployment_environment ~ '-vagrant') | to_json }}
    provider.management_network_address = {{ vagrant_management_network | to_json }}
    provider.default_prefix = {{ (project_prefix ~ '-') | to_json }}
  end

{% for vm in setup_vm_hosts | sort %}
  config.vm.define {{ vm | to_json }} do |node|
    node.vm.hostname = {{ vm | to_json }}
    node.vm.network :private_network,
      ip: {{ hostvars[vm].ansible_host | to_json }},
      netmask: {{ management_netmask | to_json }},
      libvirt__network_name: {{ (project_prefix ~ '-' ~ deployment_environment ~ '-mgmt') | to_json }}
    node.vm.provider :libvirt do |provider|
      provider.cpus = {{ hostvars[vm].vm_cpus | default(vm_cpus) | int }}
      provider.memory = {{ hostvars[vm].vm_memory_mb | default(vm_memory_mb) | int }}
    end
  end
{% endfor %}
end
